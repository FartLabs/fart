{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fart-fart-tools",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "fart.fart.tools", "custom_domain": true }]
}
